# نسخ هذا الملف إلى .env قبل الاستخدام
# cp .env-template .env

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=EventManagementDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

DATABASE_URL=Host=localhost;Port=5432;Database=EventManagementDb;Username=postgres;Password=postgres123

# pgAdmin
PGADMIN_EMAIL=admin@eventmanagement.sy
PGADMIN_PASSWORD=admin123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT_HTTPS=44300
BACKEND_PORT_HTTP=8080

# Frontend
FRONTEND_PORT=4200
NODE_ENV=development

# JWT
JWT_SECRET=YourSuperSecretKeyChangeThisInProduction!MinimumLength32Characters
JWT_EXPIRATION_MINUTES=60

# Auth Server
AUTH_SERVER_AUTHORITY=https://localhost:44300
AUTH_SERVER_REQUIRE_HTTPS=false

# CORS
CORS_ORIGINS=http://localhost:4200,https://localhost:4200

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENABLE_SSL=true

# App
APP_NAME=Event Management Platform
APP_URL=http://localhost:4200
API_URL=https://localhost:44300

