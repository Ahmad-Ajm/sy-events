name: CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Restore .NET
        run: dotnet restore CS-SY-Events/aspnet-core/EventManagement.sln
      - name: Build .NET
        run: dotnet build CS-SY-Events/aspnet-core/EventManagement.sln --configuration Release --no-restore
      - name: Install Angular deps
        working-directory: CS-SY-Events/angular
        run: npm ci
      - name: Build Angular
        working-directory: CS-SY-Events/angular
        run: npm run build
