{
  "info": {
    "name": "EventManagement API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Events",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{BACKEND_URL}}/api/app/event",
          "host": [ "{{BACKEND_URL}}" ],
          "path": [ "api", "app", "event" ]
        }
      }
    }
  ]
}
